{
  "manifest_version": 3,
  "name": "Download Manager",
  "version": "1.0.0",
  "description": "Download Manager ile her videoyu ve dosyayı tek tıkla indir.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Download Manager"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications",
    "nativeMessaging"
  ],

  "host_permissions": [
    "http://127.0.0.1:60315/*",
    "<all_urls>"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "downloadmanager@local",
      "strict_min_version": "109.0"
    }
  }
}
